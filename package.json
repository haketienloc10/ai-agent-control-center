{
  "name": "ai-agent-control-center",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "npm run dev -w @aacc/api",
    "dev:web": "npm run dev -w @aacc/web",
    "typecheck": "npm run typecheck --workspaces",
